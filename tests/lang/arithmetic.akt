fn main() int {
    int a = 7
    int b = 5
    println(f"sum = {a + b}")
    println(f"diff = {a - b}")
    println(f"mul = {a * b}")
    println(f"div = {a / b}")
    println(f"mod = {a % b}")
    println(f"pow = {2 ** 10}")
    println(f"cmp = {a > b}")
    println(f"ternary = {a > b ? "yes" : "no"}")
    return 0
}
