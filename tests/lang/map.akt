fn main() int {
    Map<string, i32> ages = {}
    ages.set("alice", 30)
    ages.set("bob", 25)
    println(f"len = {ages.len()}")
    println(f"alice = {ages.get("alice") ?? -1}")
    println(f"missing = {ages.get("carol") ?? -1}")
    println(f"has bob = {ages.contains("bob")}")
    ages.remove("bob")
    println(f"after remove = {ages.len()}")

    Map<string, string> names = { "x": "one", "y": "two" }
    println(f"x = {names.get("x") ?? "?"}")
    return 0
}
