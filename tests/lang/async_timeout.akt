async fn quick() int {
    await sleep_ms(1)
    return 7
}

async fn slow() int {
    await sleep_ms(100)
    return 9
}

fn main() int {
    switch (await async.timeout(50, quick())) {
        case Ok(v): println(f"quick = {v}")
        case Err(e): println(f"err = {e}")
    }
    switch (await async.timeout(10, slow())) {
        case Ok(v): println(f"slow = {v}")
        case Err(e): println(f"timeout = {e}")
    }
    return 0
}
