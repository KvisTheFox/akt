async fn fetch(int id) int {
    await sleep_ms(5)
    return id * 10
}

async fn fast() int {
    await sleep_ms(1)
    return 7
}

async fn slow() int {
    await sleep_ms(50)
    return 8
}

fn main() int {
    auto all = await async.all([fetch(1), fetch(2), fetch(3)])
    println(f"all len = {all.len()}, first = {all[0]}, last = {all[2]}")

    int first = await async.select([slow(), fast()])
    println(f"select = {first}")
    return 0
}
