enum Shape {
    Circle(f64)
    Rect(f64, f64)
}

fn area(Shape s) f64 {
    switch (s) {
        case Shape::Circle(r):
            return 3.141592653589793 * r * r
        case Shape::Rect(w, h):
            return w * h
    }
}

fn main() int {
    Shape a = Shape::Circle(2.0)
    Shape b = Shape::Rect(3.0, 4.0)
    println(f"circle = {area(a)}")
    println(f"rect = {area(b)}")
    return 0
}
