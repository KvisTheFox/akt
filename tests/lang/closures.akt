fn main() int {
    Vector<i32> nums = [1, 2, 3, 4, 5, 6]
    int limit = 3
    auto evens = nums.filter(|x| x % 2 == 0)
    auto big = nums.filter(|x| x > limit)
    auto squared = nums.map(|x| x * x)
    int total = nums.reduce(0, |acc, x| acc + x)
    println(f"evens len = {evens.len()}, first = {evens[0]}")
    println(f"big len = {big.len()}, first = {big[0]}")
    println(f"squared len = {squared.len()}, last = {squared[squared.len() - 1]}")
    println(f"total = {total}")
    return 0
}
