fn main() int {
    println(f"pid > 0 = {process.pid() > 0}")
    println(f"rand >= 0 = {random.int(10) >= 0}")
    println(f"fnv = {hash.fnv1a("hello")}")
    string enc = base64.encode("hello")
    println(f"b64 = {enc}")
    println(f"dec = {base64.decode(enc)}")

    Vector<string> files = fs.list_dir(".")
    println(f"files >= 0 = {files.len() >= 0}")
    return 0
}
