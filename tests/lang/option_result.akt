fn find(int id) Option<string> {
    if (id == 1) { return Some("one") }
    return None
}

fn divide(int a, int b) Result<int, string> {
    if (b == 0) { return Err("division by zero") }
    return Ok(a / b)
}

fn plus_one(int a, int b) Result<int, string> {
    int x = divide(a, b)?
    return Ok(x + 1)
}

fn main() int {
    switch (find(1)) {
        case Some(name):
            println(f"found {name}")
        case None:
            println("not found")
    }

    switch (divide(10, 2)) {
        case Ok(v):
            println(f"ok {v}")
        case Err(e):
            println(f"err {e}")
    }

    switch (plus_one(10, 5)) {
        case Ok(v):
            println(f"chain {v}")
        case Err(e):
            println(f"chain err {e}")
    }

    string fallback = find(2) ?? "nobody"
    println(f"fallback {fallback}")
    return 0
}
