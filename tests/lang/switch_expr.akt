enum Color { Red, Green, Blue }

fn name(Color c) string {
    return switch (c) {
        case Color::Red: "red"
        case Color::Green: "green"
        default: "blue"
    }
}

fn main() int {
    println(name(Color::Green))
    println(f"grade = {switch (75) { case 90..=100: "A" case 70..=89: "B" default: "F" }}")
    return 0
}
