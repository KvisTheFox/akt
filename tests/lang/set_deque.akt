fn main() int {
    Set<i32> s = [1, 2, 2, 3]
    s.add(4)
    s.add(3)
    println(f"set len = {s.len()}")
    println(f"has 2 = {s.contains(2)}")
    s.remove(2)
    println(f"after remove = {s.len()}, has 2 = {s.contains(2)}")
    for (x in s) {
        print(f"{x} ")
    }
    println("")

    Deque<i32> dq = []
    dq.push_back(2)
    dq.push_front(1)
    dq.push_back(3)
    println(f"front = {dq.front()}, back = {dq.back()}, len = {dq.len()}")
    return 0
}
