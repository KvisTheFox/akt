const i64 D = 256
const i64 NN = 65536
[f64; 65536] a
[f64; 65536] b
[f64; 65536] c

fn main() int {
    for (i in 0..NN) {
        a[i] = ((i % 13) as f64)
        b[i] = ((i % 7) as f64)
        c[i] = 0.0
    }
    for (r in 0..D) {
        for (k in 0..D) {
            f64 av = a[r * D + k]
            i64 base = k * D
            i64 out = r * D
            for (col in 0..D) {
                c[out + col] += av * b[base + col]
            }
        }
    }
    f64 sum = 0.0
    for (i in 0..NN) { sum += c[i] }
    println(f"matmul {sum:.2}")
    return 0
}
